<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- 渲染表面 - 全屏 -->
    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部信息叠加层 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#80000000">

        <!-- 标题 -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎮 GPU Benchmark"
            android:textSize="18sp"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- 设备信息 -->
        <TextView
            android:id="@+id/tvDeviceInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GPU: 加载中..."
            android:textSize="11sp"
            android:textColor="#FFAAAAAA"
            android:gravity="center"
            android:fontFamily="monospace"
            android:paddingTop="4dp" />

        <!-- FPS 显示 -->
        <TextView
            android:id="@+id/tvFps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FPS: --"
            android:textSize="56sp"
            android:textColor="#FF00FF00"
            android:textStyle="bold"
            android:gravity="center"
            android:fontFamily="monospace" />

        <!-- 详细信息 -->
        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="帧时间: -- ms | 三角形: --"
            android:textSize="13sp"
            android:textColor="#FFCCCCCC"
            android:gravity="center"
            android:fontFamily="monospace" />

        <!-- 状态 -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="等待开始..."
            android:textSize="12sp"
            android:textColor="#FF888888"
            android:gravity="center"
            android:paddingTop="4dp" />

    </LinearLayout>

    <!-- 底部控制区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#80000000">

        <!-- API 选择 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/btnGL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OpenGL ES"
                android:textSize="14sp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#FF2196F3"
                android:textColor="#FFFFFFFF" />

            <Button
                android:id="@+id/btnVulkan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vulkan"
                android:textSize="14sp"
                android:backgroundTint="#FFFF9800"
                android:textColor="#FFFFFFFF" />

        </LinearLayout>

        <!-- 开始/停止按钮 -->
        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="▶ 开始测试"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#FF4CAF50"
            android:textColor="#FFFFFFFF" />

        <!-- 历史记录按钮 -->
        <Button
            android:id="@+id/btnHistory"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="📊 查看历史记录"
            android:textSize="14sp"
            android:backgroundTint="#FF333333"
            android:textColor="#FFFFFFFF"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</FrameLayout>
